# =============================================================================
# TreeKB Environment Configuration
# Copy this file to .env and fill in your values.
# =============================================================================

# -----------------------------------------------------------------------------
# Server
# -----------------------------------------------------------------------------
PORT=3000

# -----------------------------------------------------------------------------
# Logging
# -----------------------------------------------------------------------------
# Log level: DEBUG | INFO | WARN | ERROR
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# LLM Provider
# -----------------------------------------------------------------------------
# Which provider to use: gemini | openai
LLM_PROVIDER=gemini

# Optional: override the model used for answer generation (any provider model)
ANSWER_MODEL=

# LLM request timeout in milliseconds (default: 480000 = 8 minutes)
LLM_TIMEOUT_MS=480000

# -----------------------------------------------------------------------------
# OpenAI
# -----------------------------------------------------------------------------
OPENAI_API_KEY=sk-your-openai-api-key-here
OPENAI_MODEL=gpt-5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# -----------------------------------------------------------------------------
# Google Gemini (API Key mode)
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# -----------------------------------------------------------------------------
# Google Vertex AI (service account mode — set VERTEX_AI=true to enable)
# -----------------------------------------------------------------------------
VERTEX_AI=false
VERTEX_PROJECT=your-gcp-project-id
VERTEX_LOCATION=us-central1
GOOGLE_SERVICE_ACCOUNT_KEY=path/to/service-account-key.json

# -----------------------------------------------------------------------------
# Embeddings
# -----------------------------------------------------------------------------
# Set to "true" to disable all embedding generation
DISABLE_EMBEDDINGS=false

# -----------------------------------------------------------------------------
# Ingestion — Queue
# -----------------------------------------------------------------------------
# Concurrent ingestion jobs (default: 1)
INGEST_QUEUE_CONCURRENCY=1
# Max retry attempts per job (default: 3)
INGEST_QUEUE_MAX_ATTEMPTS=3
# Delay between retries in ms (default: 5000)
INGEST_QUEUE_RETRY_DELAY_MS=5000
# Minutes before a running job is considered stuck (default: 30, 0 = disabled)
INGEST_STUCK_TIMEOUT_MINUTES=30

# -----------------------------------------------------------------------------
# Ingestion — Batch Sizes
# -----------------------------------------------------------------------------
# Segment extraction batch size (default: 1)
INGEST_SEGMENT_BATCH=1
# KP decision batch size (default: 1)
INGEST_KP_BATCH=1
# Documents processed concurrently per batch (default: 1)
INGEST_BATCH_CONCURRENCY=1

# -----------------------------------------------------------------------------
# Ingestion — File Handling
# -----------------------------------------------------------------------------
# Max upload file size in MB (default: 200)
INGEST_MAX_FILE_MB=200
# Max files per batch upload (default: 100)
INGEST_MAX_BATCH_FILES=100

# -----------------------------------------------------------------------------
# Ingestion — Post-Processing
# -----------------------------------------------------------------------------
# Delete uploaded file after successful ingestion (default: true)
INGEST_CLEANUP_ON_SUCCESS=true
# Auto-generate embeddings after ingestion (default: true)
INGEST_AUTO_EMBED=true
# Merge orphan nodes (<2 chunks) into parent (default: false)
INGEST_ORPHAN_CLEANUP=false

# -----------------------------------------------------------------------------
# Reranker
# -----------------------------------------------------------------------------
# Enable LLM-based reranking (default: false)
RERANKER_LLM_ENABLED=false
# Number of top chunks to send to LLM reranker (default: 8, range: 3-12)
RERANKER_LLM_TOP_N=8
